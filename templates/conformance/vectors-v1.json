{
  "vectors_version": "v1",
  "law_anchor": "family-dev-handbook v0.11.0 — docs/02 (L1-9 / L1-10 / L1-11), docs/05 (FP-7)",
  "id_convention": "実名モデル ID を含まない (L1-10)。抽象語彙: モデル= model-a/model-b/…、系統= family-a/…、実装 writer= model-w (family-w)、メンバー= member-a。",
  "kinds": {
    "panel": "席構成の適法性を判定する。expect = {required_seats, lawful, failure_class}",
    "seat_wait": "SEAT-WAIT 宣言の有効性を判定する。expect = {valid, failure_class}",
    "record": "レビュー記録の形式要件を判定する。expect = {valid, failure_class}"
  },
  "failure_classes": {
    "underseated": "席数未達 (数えられない席・無記録の同系統着席・不適法な降格を含む — L1-10/L1-11)",
    "invalid-seat-wait": "SEAT-WAIT 宣言が必須3点を欠く・対象がレーンでない (L1-11)",
    "invalid-record": "レビュー記録の必須項目欠落 (L1-10)"
  },
  "given_semantics": {
    "omitted_keys": "exception_record / seats[].downgrade / seats[].agent / seats[].role_conflict の省略は「不在」(present:false 相当・フラグ偽) と同義。review_record の省略のみ「当該ベクタの主張対象外」— panel の lawful は席構成 (数・異種・writer/設計者の除外・降格・系統・例外レコードと適用明記) の関数であり、requested/actual の記録要件は kind=record が別途検証する",
    "member_floor3.effective": "3値: true=発効済み / false=発効データ記録済みだが未発効 (旧床を主張できる) / null=発効状態を主張できない (pinned Issue 不在・不備)。effective は入力事実として与える — adapter に発効日から導出させない",
    "distinct_lineages_available": "その家で起動可能なモデル系統の数 (L1-11 降格手続きの適用要件「起動可能なモデル系統が席数未満」の入力事実)。省略時は「席数以上が起動可能」(降格の適用要件を満たさない) と読む",
    "exception_record.fields_present": "レコード本文の値解釈 (pair の一致・scope が実際にレーンを覆うか) は given の消化済みフラグ (scope_covers_lane 等) が正 — 本文解釈層は本 suite の検証対象外。writer_condition は法 (L1-10) がフィールド名を列挙するのみで意味論を定めない — adapter 側で法に無い意味を捏造しないこと",
    "writer_at_upstream": "上流 (L1-9) 段階で writer 未選出の実装は writer を null に写像してよい — v1 の上流ベクタで writer は判定の決定因ではない",
    "role_conflict": "許容値: designer / implementer / orchestrator (審査対象を設計・実装した者およびオーケストレーター — L1-10 により席に数えない)"
  },
