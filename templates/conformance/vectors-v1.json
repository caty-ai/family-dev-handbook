    "record": "レビュー記録の形式要件を判定する。expect = {valid}"
  },
  "failure_classes": {
    "underseated": "席数未達 (数えられない席・無記録の同系統着席・無承認の降格を含む — L1-10/L1-11)",
    "invalid-seat-wait": "SEAT-WAIT 宣言が必須3点を欠く・対象がレーンでない (L1-11)",
    "invalid-record": "レビュー記録の必須項目欠落 (L1-10)"
  },
